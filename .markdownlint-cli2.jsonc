{
  "globs": [
    "docs/**/*.md",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "ignores": [
    "docs/.vitepress/**",
    "node_modules/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD025": false,
    "MD029": false,
    "MD036": false,
    "MD040": false,
    "MD060": false
  },
  "fix": true
}
